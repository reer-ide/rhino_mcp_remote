# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
DEBUG=false
RELOAD=false

# Redis Configuration
REDIS_URL=redis://<REDIS_HOST>:<REDIS_PORT>/<REDIS_DB>
# OR individual settings:
# REDIS_HOST= <REDIS_HOST>
# REDIS_PORT= <REDIS_PORT>
# REDIS_DB= <REDIS_DB>

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://rhinomcp:password@localhost:5432/rhinomcp
# OR individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rhinomcp
# DB_USER=rhinomcp
# DB_PASSWORD=password

# Authentication
JWT_SECRET=your-secret-key-here

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=reer-remote-rhinomcp 