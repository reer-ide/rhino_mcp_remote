# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DEBUG=false
RELOAD=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
# OR individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://rhinomcp:password@localhost:5432/rhinomcp
# OR individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rhinomcp
# DB_USER=rhinomcp
# DB_PASSWORD=password

# Authentication
JWT_SECRET=your-secret-key-here

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=reer-remote-rhinomcp 